# Screener Playwright Crawler — cron job image
# Runs the CLI pipeline directly (docker runtime cron can't use startCommand,
# so the entry command lives here in CMD).

FROM mcr.microsoft.com/playwright:v1.45.0-jammy

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev || npm install --omit=dev

COPY tsconfig.json ./
COPY src ./src
RUN npx tsc || true

COPY index.html ./
COPY nginx.conf ./

RUN mkdir -p reports generated-tests

# CLI entry — override via env URL in render.yaml envVars if needed
ENV SEED_URL=https://demoqa.com
ENV MAX_PAGES=10

CMD ["sh", "-c", "node dist/index.js --mode full --url $SEED_URL --max-pages $MAX_PAGES"]
