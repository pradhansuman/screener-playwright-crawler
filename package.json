{
  "name": "screener-playwright-crawler",
  "version": "2.1.0",
  "description": "14-step E2E automated testing pipeline: Application Understanding → GO / NO-GO, powered by Playwright",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "crawl": "ts-node src/index.ts --mode crawl",
    "analyze": "ts-node src/index.ts --mode analyze",
    "generate": "ts-node src/index.ts --mode generate",
    "full": "ts-node src/index.ts --mode full",
    "pipeline": "ts-node src/pipeline.ts",
    "risk": "ts-node src/risk-assessor.ts",
    "server": "ts-node src/server.ts",
    "build:server": "tsc"
  },
  "dependencies": {
    "bloom-filters": "^3.0.0",
    "chalk": "^5.3.0",
    "express": "^4.22.2",
    "fast-xml-parser": "^4.4.0",
    "playwright": "^1.45.0",
    "robots-parser": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
